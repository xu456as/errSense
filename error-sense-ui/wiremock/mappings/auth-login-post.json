{
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/auth/login"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "transformers": [
      "response-template"
    ],
    "jsonBody": {
      "email": "{{jsonPath request.body '$.email'}}",
      "token": "mock-errsense-token"
    }
  }
}
